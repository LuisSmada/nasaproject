{
  "name": "nasa-fe",
  "version": "1.0.2",
  "private": true,
  "dependencies": {
    "arwes": "1.0.0-alpha.5",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.1",
    "browserslist": "^4.27.0",
    "caniuse-lite": "^1.0.30001751",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.4",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env BUILD_PATH=../server/public react-scripts build",
    "test": "react-scripts test --passWithNoTests",
    "eject": "react-scripts eject",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true --error-on-warnings --max-diagnostics=none src",
    "lint:fix": "npm run lint --write --unsafe"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "2.1.1",
    "resolve-url-loader@4.0.0": "5.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@biomejs/biome": "2.3.2",
    "cross-env": "^7.0.3"
  }
}
